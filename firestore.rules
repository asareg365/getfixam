rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* -----------------------------
       AUTH HELPERS
    ------------------------------*/

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isProvider(providerId) {
      return isSignedIn() && request.auth.uid == providerId;
    }

    /* -----------------------------
       ADMINS
    ------------------------------*/

    match /admins/{adminId} {

      allow read: if isAdmin();

      allow write: if false; 
      // Only server/admin SDK should modify admins
    }

    /* -----------------------------
       PROVIDERS
    ------------------------------*/

    match /providers/{providerId} {

      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() || isProvider(providerId);

      allow delete: if isAdmin();

      match /jobRequests/{jobId} {
        allow read, write: if isProvider(providerId) || isAdmin();
      }

    }

    /* -----------------------------
       JOBS
    ------------------------------*/

    match /jobs/{jobId} {

      allow read: if true;

      // Allow public creation to support lead tracking from the Contact Button
      allow create: if true;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* -----------------------------
       ENGAGEMENTS (DISPATCH SYSTEM)
    ------------------------------*/

    match /engagements/{engagementId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if isSignedIn();

      allow delete: if isAdmin();
    }

    /* -----------------------------
       REVIEWS
    ------------------------------*/

    match /reviews/{reviewId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* -----------------------------
       SERVICES
    ------------------------------*/

    match /services/{serviceId} {

      allow read: if true;

      allow write: if isAdmin();
    }

    /* -----------------------------
       CATEGORIES
    ------------------------------*/

    match /categories/{categoryId} {

      allow read: if true;

      allow write: if isAdmin();
    }

    /* -----------------------------
       SYSTEM SETTINGS
    ------------------------------*/

    match /system_settings/{settingId} {

      allow read: if isAdmin();

      allow write: if isAdmin();
    }

  }
}