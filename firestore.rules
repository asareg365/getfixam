
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* -----------------------------
       AUTH HELPERS
    ------------------------------*/

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isProvider(providerId) {
      return isSignedIn() && request.auth.uid == providerId;
    }

    /* -----------------------------
       ADMINS
    ------------------------------*/

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    /* -----------------------------
       PROVIDERS
    ------------------------------*/

    match /providers/{providerId} {

      // Public can read if subscription is active and artisan is approved
      allow read: if isAdmin() || (
        resource.data.status == 'approved' && 
        resource.data.subscriptionActive == true
      ) || isProvider(providerId);

      // Allow public creation for 'pending' applications
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' && 
        request.resource.data.verified == false &&
        request.resource.data.subscriptionActive == false
      );

      allow update: if isAdmin() || isProvider(providerId);

      allow delete: if isAdmin();

      match /jobRequests/{jobId} {
        allow read, write: if isProvider(providerId) || isAdmin();
      }

    }

    /* -----------------------------
       JOBS
    ------------------------------*/

    match /jobs/{jobId} {
      allow read: if isAdmin();
      allow create: if true; // Allow visitors to track leads (calls/whatsapp)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* -----------------------------
       ENGAGEMENTS (DISPATCH SYSTEM)
    ------------------------------*/

    match /engagements/{engagementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    /* -----------------------------
       REVIEWS
    ------------------------------*/

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if true; // Allow public review submission (pending moderation)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* -----------------------------
       SERVICES
    ------------------------------*/

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* -----------------------------
       CATEGORIES
    ------------------------------*/

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* -----------------------------
       SYSTEM SETTINGS
    ------------------------------*/

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /whatsapp_events/{eventId} {
      allow read, write: if isAdmin();
    }

  }
}
